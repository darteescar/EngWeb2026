extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Informações do filme '#{elem.title}'

    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th ID
          td= elem.id
        tr 
          th Título
          td= elem.title
        tr
          th Ano
          td= elem.year
        tr 
          th Elenco
          td= elem.cast
        tr
          th Géneros
          td= elem.genres
        tr
          th Nº Géneros
            td= elem.num_generos
        tr
          th Nº Atores
          td= elem.num_atores