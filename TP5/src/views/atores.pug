extends layout 

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Atores
    .w3-container
      a.w3-button.w3-teal.w3-medium.w3-margin-top.w3-left(href="/") Página Inicial
    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th Nome
          th Nº Filmes
        each elem in lista
          tr.w3-hover-dark-grey(
            onclick=`window.location='/atores/${elem.name}'`
            style="cursor:pointer"
          ) 
            td= elem.name
            td= elem.num_filmes