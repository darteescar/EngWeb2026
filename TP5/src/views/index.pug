extends layout 

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Filmes de um Cinema

    .w3-container
      a.w3-button.w3-teal.w3-medium.w3-margin-top.w3-left(href="/atores") Atores
    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th ID
          th Título
          th Ano
          th Elenco
          th Géneros
          th Nº Géneros
          th Nº Atores
        each elem in lista
          tr.w3-hover-dark-grey(
            onclick=`window.location='/filmes/${elem.id}'`
            style="cursor:pointer"
          )
            td= elem.id
            td= elem.title
            td= elem.year
            td= elem.cast
            td= elem.genres
            td= elem.num_generos
            td= elem.num_atores
      