extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Lista de Exames Médicos

    .w3-container
      a.w3-button.w3-red.w3-medium.w3-margin-top.w3-left.w3-margin(href="/emd/registo") Adicionar
      a.w3-button.w3-teal.w3-medium.w3-margin-top.w3-left(href="/emd/stats") Estatísticas
      a.w3-button.w3-teal.w3-medium.w3-margin-top.w3-left.w3-margin(href="/emd?ordenar=nomeCrescente") Crescente
      a.w3-button.w3-teal.w3-medium.w3-margin-top.w3-left(href="/emd?ordenar=nomeDecrescente") Decrescente
      table.w3-table-all.w3-margin-top
        tr
          th Nome
          th Data
          th Modalidade
          th Resultado

        each t in list
          tr.w3-hover-dark-grey(
            onclick=`window.location='/emd/${t.id}'`
            style="cursor:pointer"
          )
            td= t.primeiro_nome + " " +  t.ultimo_nome
            td= t.dataEMD
            td= t.modalidade
            td= t.resultado ? "Apto" : "Não Apto"