extends layout.pug

block content
  .w3-container
    .w3-bar.w3-light-grey
      a.w3-bar-item.w3-button(href='/filmes') Filmes
      a.w3-bar-item.w3-button(href='/atores') Atores
      a.w3-bar-item.w3-button(href='/generos') Géneros
    
    h2.w3-margin-top= genero.nome
    .w3-panel.w3-pale-blue.w3-border
      p
        strong ID: 
        span= genero.id
      p
        strong Número de Filmes: 
        span= genero.num_filmes
      
      if filmes && genero.num_filmes > 0
        h3 Filmes
        table.w3-table-all
          tr.w3-teal
            th Título
            th Ano
          each filme in filmes
            tr.w3-hover-dark-grey(
                  onclick=`window.location='/filmes/${filme.id}'`
                  style="cursor:pointer"
                )
              td= filme.titulo
              td= filme.ano
    
    a.w3-button.w3-teal(href='/generos') ← Voltar
