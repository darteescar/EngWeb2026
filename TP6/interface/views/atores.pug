extends layout.pug

block content
  .w3-container
    h2 Lista de Atores (#{atores.length})
    
    .w3-bar.w3-light-grey
      a.w3-bar-item.w3-button(href='/filmes') Filmes
      a.w3-bar-item.w3-button.w3-teal(href='/atores') Atores
      a.w3-bar-item.w3-button(href='/generos') Géneros
    
    table.w3-table-all.w3-margin-top
      tr.w3-teal
        th ID
        th Nome
        th Nº Filmes
      each a in atores
        tr.w3-hover-dark-grey(
              onclick=`window.location='/atores/${a.id}'`
              style="cursor:pointer"
            )
          td= a.id
          td= a.nome
          td= a.num_filmes
