extends layout.pug

block content
  .w3-container
    h2 Lista de Géneros (#{generos.length})
    
    .w3-bar.w3-light-grey
      a.w3-bar-item.w3-button(href='/filmes') Filmes
      a.w3-bar-item.w3-button(href='/atores') Atores
      a.w3-bar-item.w3-button.w3-teal(href='/generos') Géneros
    
    table.w3-table-all.w3-margin-top
      tr.w3-teal
        th ID
        th Nome
        th Nº Filmes
      each g in generos
        tr.w3-hover-dark-grey(
              onclick=`window.location='/generos/${g.id}'`
              style="cursor:pointer"
            )
          td= g.id
          td= g.nome
          td= g.num_filmes
